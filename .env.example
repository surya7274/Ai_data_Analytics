# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and customize for your local environment
# DO NOT COMMIT .env FILES CONTAINING ACTUAL CREDENTIALS TO GIT
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Read-Only Database User (Recommended for n8n queries)
POSTGRES_READONLY_USER=data_analyst_readonly
POSTGRES_READONLY_PASSWORD=ReadonlyAnalyst#2024

# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=Asia/Kolkata

# Optional: LLM API Keys (For natural language synthesis)
# Supported options: OpenAI, Google Gemini, Anthropic, or Ollama (local/free)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
